# Exemple uniquement. Ne jamais commiter les valeurs réelles.
LUXE_RADAR_SECRET_KEY=replace-with-at-least-32-random-bytes
LUXE_RADAR_ENV=development
LUXE_RADAR_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
LUXE_RADAR_HTTPS=false
LUXE_RADAR_TRUST_PROXY=false
LUXE_RADAR_VERBOSE=false

# Paiement Stripe (mode test recommandé pour commencer).
# Clé trouvée dans le tableau de bord Stripe -> Developers -> API keys.
# Tant qu'elle est vide, le paiement reste désactivé et la démo 7 jours est proposée.
STRIPE_SECRET_KEY=
LUXE_RADAR_PUBLIC_BASE_URL=http://localhost:5000

# Connecteurs officiels uniquement.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
